{
  "name": "virtual-rodent-lab",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite",
    "serve": "node scripts/serve-docs.mjs",
    "test": "vitest run",
    "ci": "node tools/ci-local.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "vr-slice-check": "node tools/vr-slice-check.mjs",
    "lint": "eslint docs/",
    "bump-build": "node tools/bump-build.mjs",
    "boot-check": "node tools/boot-check.mjs",
    "gpu-diagnostics-check": "node tools/gpu-diagnostics-check.mjs",
    "vr-gpu-prepare-check": "node tools/vr-gpu-prepare-check.mjs",
    "vr-render-golden": "node tools/vr-render-golden.mjs",
    "vr-render-golden:update": "node tools/vr-render-golden.mjs --update",
    "vr-cls-parity": "node tools/vr-cls-parity.mjs",
    "vr-depth-check": "node tools/vr-depth-check.mjs",
    "vr-guards": "node tools/vr-gpu-prepare-check.mjs && node tools/vr-render-golden.mjs && node tools/vr-cls-parity.mjs && node tools/vr-depth-check.mjs && node tools/vr-fovea-check.mjs",
    "vr-fovea-check": "node tools/vr-fovea-check.mjs",
    "vr-start-flicker-check": "node tools/vr-start-flicker-check.mjs",
    "edit-mask-check": "EDITTEX=1 EDIT=3 CUT=1 PASSES=1 node tools/volume-shader-check.mjs docs/medical-volume.js '' test-results/edit-mask && EDITTEX=1 EDIT=2 SPECKS=2 MPR=1 SECTION=1 PASSES=1 node tools/volume-shader-check.mjs docs/medical-volume.js '' test-results/edit-mask",
    "progress-modal-check": "node tools/progress-modal-check.mjs",
    "analysis-project-check": "node tools/analysis-project-check.mjs",
    "analysis-label-3d-check": "node tools/analysis-label-3d-check.mjs",
    "edit-consistency-check": "node tools/edit-consistency-check.mjs",
    "analysis-fringe-check": "node tools/analysis-fringe-check.mjs",
    "result-2d-check": "node tools/result-2d-check.mjs",
    "plane-sync-check": "node tools/plane-sync-check.mjs",
    "mpr-alpha-check": "node tools/mpr-alpha-check.mjs",
    "processed-filter-check": "node tools/processed-filter-check.mjs",
    "plane-orientation-check": "node tools/plane-orientation-check.mjs",
    "sigmoid-check": "node tools/sigmoid-check.mjs",
    "exclusive-segments-check": "node tools/exclusive-segments-check.mjs",
    "region-deselect-check": "node tools/region-deselect-check.mjs",
    "slider-entry-check": "node tools/slider-entry-check.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "acorn": "8.18.0",
    "acorn-walk": "8.3.5",
    "dicom-parser": "1.8.21",
    "eslint": "9.39.5",
    "fake-indexeddb": "6.2.5",
    "fflate": "0.8.2",
    "globals": "17.12.0",
    "three": "0.186.0",
    "vite": "8.3.0",
    "vitest": "5.0.2",
    "wgsl_reflect": "1.6.0"
  },
  "license": "AGPL-3.0-only"
}
